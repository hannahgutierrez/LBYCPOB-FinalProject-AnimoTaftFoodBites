<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ph.edu.dlsu.lbycpob.animotaftfoodbites.controller.FoodPlaceController"
           styleClass="root-container" stylesheets="@style.css">

    <!-- 1. MAIN DIRECTORY SCREEN -->
    <VBox fx:id="mainScreen" alignment="TOP_CENTER" spacing="15" maxWidth="700" maxHeight="500" styleClass="card-panel">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <ComboBox fx:id="categoryFilter" promptText="Category" prefWidth="150" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="adminAuthButton" text="🔑 Admin Login" onAction="#handleAdminButtonClick" styleClass="pill-button"/>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <FlowPane fx:id="restaurantGrid" hgap="20" vgap="20" alignment="CENTER">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
            </FlowPane>
        </ScrollPane>
    </VBox>

    <!-- 2. RESTAURANT DETAILS SCREEN -->
    <VBox fx:id="detailsScreen" visible="false" alignment="TOP_CENTER" spacing="15" maxWidth="700" maxHeight="500" styleClass="card-panel">
        <HBox alignment="CENTER_RIGHT">
            <Button text="✕ Back" onAction="#showMainScreen" styleClass="pill-button"/>
        </HBox>
        <Label fx:id="detailNameLabel" styleClass="card-title" style="-fx-font-size: 20px;"/>
        <HBox spacing="20" alignment="CENTER">
            <VBox spacing="10" alignment="CENTER">
                <ImageView fx:id="detailLogoImageView" fitWidth="120" fitHeight="120" preserveRatio="true"/>
                <Button text="Menu" onAction="#showMenuScreen" styleClass="pill-button" prefWidth="120"/>
                <Button text="Directions" onAction="#openGoogleMaps" styleClass="pill-button" prefWidth="120"/>
            </VBox>
            <VBox spacing="8" alignment="CENTER_LEFT">
                <ImageView fx:id="detailStoreImageView" fitWidth="280" fitHeight="160" preserveRatio="true"/>
                <Label fx:id="detailHoursLabel" styleClass="details-label"/>
                <Label fx:id="detailContactLabel" styleClass="details-label"/>
                <Label fx:id="detailAddressLabel" styleClass="details-label" wrapText="true" maxWidth="300"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- 3. MENU SCREEN -->
    <VBox fx:id="menuScreen" visible="false" alignment="TOP_CENTER" spacing="15" maxWidth="700" maxHeight="500" styleClass="card-panel">
        <HBox alignment="CENTER_LEFT" prefWidth="2000.0" spacing="10">
            <Label fx:id="menuTitleLabel" styleClass="card-title" style="-fx-font-size: 18px;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="◄ Prev" onAction="#prevMenuImage" styleClass="pill-button"/>
            <Label fx:id="menuPageLabel" text="Page 1/1" styleClass="details-label"/>
            <Button text="Next ►" onAction="#nextMenuImage" styleClass="pill-button"/>
            <Button text="✕ Back" onAction="#showDetailsScreen" styleClass="pill-button"/>
        </HBox>
        <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
            <ImageView fx:id="menuImageView" preserveRatio="true"/>
        </ScrollPane>
    </VBox>

</StackPane>