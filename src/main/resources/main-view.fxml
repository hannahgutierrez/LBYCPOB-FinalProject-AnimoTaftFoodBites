<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ph.edu.dlsu.lbycpob.animotaftfoodbites.controller.FoodPlaceController"
           styleClass="root-container" stylesheets="@style.css">

    <!-- 1. MAIN DIRECTORY SCREEN -->
    <VBox fx:id="mainScreen" alignment="TOP_CENTER" spacing="15" maxWidth="700" maxHeight="500" styleClass="card-panel">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <ComboBox fx:id="categoryFilter" promptText="Category" prefWidth="150" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="adminAuthButton" text="🔑 Admin Login" onAction="#handleAdminButtonClick" styleClass="pill-button"/>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <FlowPane fx:id="restaurantGrid" hgap="20" vgap="20" alignment="CENTER">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
            </FlowPane>
        </ScrollPane>
    </VBox>

    <!-- 2. RESTAURANT DETAILS SCREEN -->
    <VBox fx:id="detailsScreen" visible="false" alignment="TOP_CENTER" spacing="15" maxWidth="700" maxHeight="500" styleClass="card-panel">
        <HBox alignment="CENTER_RIGHT">
            <Button text="✕ Back" onAction="#showMainScreen" styleClass="pill-button"/>
        </HBox>
        <Label fx:id="detailNameLabel" styleClass="card-title" style="-fx-font-size: 20px;"/>
        <HBox spacing="20" alignment="CENTER">
            <VBox spacing="10" alignment="CENTER">
                <ImageView fx:id="detailLogoImageView" fitWidth="120" fitHeight="120" preserveRatio="true"/>
                <Button text="Menu" onAction="#showMenuScreen" styleClass="pill-button" prefWidth="120"/>
                <Button text="Directions" onAction="#openGoogleMaps" styleClass="pill-button" prefWidth="120"/>
            </VBox>
            <VBox spacing="8" alignment="CENTER_LEFT">
                <ImageView fx:id="detailStoreImageView" fitWidth="280" fitHeight="160" preserveRatio="true"/>
                <Label fx:id="detailHoursLabel" styleClass="details-label"/>
                <Label fx:id="detailContactLabel" styleClass="details-label"/>
                <Label fx:id="detailAddressLabel" styleClass="details-label" wrapText="true" maxWidth="300"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- 3. MENU SCREEN -->
    <VBox fx:id="menuScreen" visible="false" alignment="TOP_CENTER" spacing="15" maxWidth="700" maxHeight="500" styleClass="card-panel">
        <HBox alignment="CENTER_LEFT" prefWidth="2000.0" spacing="10">
            <Label fx:id="menuTitleLabel" styleClass="card-title" style="-fx-font-size: 18px;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="◄ Prev" onAction="#prevMenuImage" styleClass="pill-button"/>
            <Label fx:id="menuPageLabel" text="Page 1/1" styleClass="details-label"/>
            <Button text="Next ►" onAction="#nextMenuImage" styleClass="pill-button"/>
            <Button text="✕ Back" onAction="#showDetailsScreen" styleClass="pill-button"/>
        </HBox>
        <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
            <ImageView fx:id="menuImageView" preserveRatio="true"/>
        </ScrollPane>
    </VBox>

    <!-- 4. ADD RESTAURANT FORM (ADMIN ONLY) -->
    <VBox fx:id="addFormScreen" visible="false" alignment="TOP_CENTER" spacing="10" maxWidth="600" maxHeight="520" styleClass="card-panel">
        <Label text="Add New Restaurant (Admin)" styleClass="card-title" style="-fx-font-size: 18px;"/>
        <GridPane hgap="10" vgap="10" alignment="CENTER">
            <TextField fx:id="inputName" promptText="Complete Restaurant Name" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="inputCategory" promptText="Category (e.g. Fast Food, Cafe)" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <TextField fx:id="inputAddress" promptText="Complete Address" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="inputHours" promptText="Opening Hours (e.g. 24 Hours)" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <TextField fx:id="inputContact" promptText="Contact Number" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="inputMapUrl" promptText="Google Maps Share Link" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Button text="Select Logo Image" onAction="#uploadLogo" GridPane.columnIndex="0" GridPane.rowIndex="3" prefWidth="200"/>
            <Button text="Select Store Image" onAction="#uploadStoreImage" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="200"/>
            <Button text="Select Menu Image" onAction="#uploadMenuImage" GridPane.columnIndex="0" GridPane.rowIndex="4" prefWidth="200"/>
        </GridPane>
        <HBox spacing="15" alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="Save Restaurant" onAction="#saveRestaurant" styleClass="pill-button"/>
            <Button text="Cancel" onAction="#showMainScreen" styleClass="pill-button"/>
        </HBox>
    </VBox>

    <!-- 5. ADMIN LOGIN MODAL OVERLAY -->
    <VBox fx:id="loginModal" visible="false" alignment="CENTER" styleClass="modal-overlay">
        <VBox spacing="12" alignment="CENTER" maxWidth="380" styleClass="modal-card">
            <Label text="User Login" styleClass="modal-title"/>
            <TextField fx:id="adminUsernameField" promptText="Username" maxWidth="300"/>
            <PasswordField fx:id="adminPasswordField" promptText="Password" maxWidth="300"/>
            <Label fx:id="loginErrorLabel" textFill="red" visible="false"/>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Login" onAction="#loginAdmin" styleClass="pill-button"/>
                <Button text="Cancel" onAction="#closeLoginModal" styleClass="pill-button"/>
            </HBox>

            <Hyperlink text="Don't have an account? Create one here" onAction="#openRegisterModal"/>
        </VBox>
    </VBox>

    <!-- REGISTER MODAL -->
    <VBox fx:id="registerModal" visible="false" alignment="CENTER" styleClass="modal-overlay">
        <VBox spacing="12" alignment="CENTER" maxWidth="380" styleClass="modal-card">
            <Label text="Create New Account" styleClass="modal-title"/>
            <TextField fx:id="regUsernameField" promptText="Enter Username" maxWidth="300"/>
            <PasswordField fx:id="regPasswordField" promptText="Enter Password" maxWidth="300"/>
            <PasswordField fx:id="regConfirmPasswordField" promptText="Confirm Password" maxWidth="300"/>
            <Label fx:id="regErrorLabel" textFill="red" visible="false"/>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Register Account" onAction="#registerUser" styleClass="pill-button"/>
                <Button text="Cancel" onAction="#closeRegisterModal" styleClass="pill-button"/>
            </HBox>

            <Hyperlink text="Already have an account? Log in" onAction="#handleAdminButtonClick"/>
        </VBox>
    </VBox>
</StackPane>